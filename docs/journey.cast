[0.018, "o", "\u001b[?25l\u001b[2m\u001b[1;97H\u2502 \u001b[m\u000f\u001b[36m\u001b[1m\u2728\u200aUpdate available!\u001b[m\u000f \u001b[1m0.153.3 -> 0.153.4\u001b[m\u000f\u001b[2m         \u2502\u001b[m\u000f\u001b[K\u001b[2m\u001b[2;97H\u2502 \u001b[m\u000fRun \u001b[36mnpm install -g @openai/codex\u001b[39m to update.\u001b[2m     \u2502\u001b[m\u000f\u001b[K\u001b[2m\u001b[3;97H\u2502                                                 \u2502\u001b[m\u000f\u001b[K\u001b[2m\u001b[4;97H\u2502 \u001b[m\u000fSee full release notes:\u001b[2m                         \u2502\u001b[m\u000f\u001b[K\u001b[2m\u001b[5;97H\u2502 \u001b[m\u000f\u001b[36m\u001b[4m\u001b]8;id=tmux1E;https://github.com/openai/codex/releases/latest\u001b\\https://github.com/openai/codex/releases/latest\u001b]8;;\u001b\\\u001b[m\u000f\u001b[2m \u2502\u001b[m\u000f\u001b[K\u001b[2m\u001b[6;97H\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256f\u001b[m\u000f\u001b[K\u001b[7;97H\u001b[K\u001b[2m\n\u256d\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256e\u001b[m\u000f\u001b[K\u001b[2m\u001b[9;97H\u2502 >_ \u001b[m\u000f\u001b[1mOpenAI Codex\u001b[m\u000f\u001b[2m (v0.153.3)                       \u2502\u001b[m\u000f\u001b[K\u001b[2m\u001b[10;97H\u2502                                                  "]
