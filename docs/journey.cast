[0.0, "o", "\u2500\u2500\u256e\u001b[m\u000f\u001b[K\u001b[2m\u001b[10;97H\u2502 >_ \u001b[m\u000f\u001b[1mOpenAI Codex\u001b[m\u000f\u001b[2m (v0.153.3)                       \u2502\u001b[m\u000f\u001b[K\u001b[2m\u001b[11;97H\u2502                                                  \u2502\u001b[m\u000f\u001b[K\u001b[2m\u001b[12;97H\u2502 model:     \u001b[m\u000fgpt-6-astra medium\u001b[2m   \u001b[m\u000f\u001b[36m/model\u001b[39m\u001b[2m to change \u2502\u001b[m\u000f\u001b[K\u001b[2m\u001b[13;97H\u2502 directory: \u001b[m\u000f~/funProjects/cxpeer\u001b[2m                  \u2502\u001b[m\u000f\u001b[K\u001b[2m\u001b[14;97H\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256f\u001b[m\u000f\u001b[K\u001b[15;97H\u001b[K\n  \u001b[1mTip:\u001b[m\u000f \u001b[3mNew\u001b[m\u000f Use \u001b[1m/fast\u001b[m\u000f to enable our fastest inference with increased plan\u001b[K\u001b[17;97H  usage.\u001b[K\u001b[18;97H\u001b[K\n\u001b[K\u001b[1m\u001b[2m\n\u203a \u001b[m\u000fSay READY and nothing else.\u001b[K\u001b[21;97H\u001b[K\n\u001b[K\n\u001b[K\n \u001b[K\u001b[38;2;128;128;128m\u001b[1m\u001b[25;97H\u2022\u001b[m\u000f \u001b[38;2;128;128;128m\u001b[1mBooting MCP server: codex_apps\u001b[m\u000f \u001b[2m(0s \u2022 esc to interrupt)\u001b[m\u000f\u001b[K\u001b[26;97H \u001b[K\u001b[27;97H \u001b[K\u001b[1m\u001b[28;97H\u203a\u001b[m\u000f \u001b[2mAsk Codex to do anything\u001b[m\u000f\u001b[K\u001b[29;97H \u001b[K\u001b[30;97H  \u001b[38;2;246;226;183mgpt-6-astra me"]
