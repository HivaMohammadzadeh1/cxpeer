[0.0, "o", "\u001b[10;138H\u001b[K\u001b[11;97H\u001b[2m\u2502 model:     \u001b[3mloading\u001b[m\u000f\u001b[2m   \u001b[m\u000f\u001b[36m/model\u001b[39m\u001b[2m to change \u2502\u001b[m\u000f\u001b[K\u001b[12;97H\u001b[2m\u2502 directory: \u001b[m\u000f~/funProjects/cxpeer\u001b[2m       \u2502\u001b[m\u000f\u001b[K\u001b[13;97H\u001b[2m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256f\u001b[m\u000f\u001b[K\u001b[14;97H \u001b[K\u001b[15;97H \u001b[K\u001b[16;97H\u001b[1m\u203a\u001b[m\u000f \u001b[2mAsk Codex to do anything\u001b[m\u000f\u001b[K\u001b[17;97H \u001b[K\u001b[18;97H  \u001b[38;5;223mgpt-5.6-luna default\u001b[39m\u001b[2m \u00b7 \u001b[m\u000f\u001b[38;5;151m~/funProjects/cxpeer\u001b[39m\u001b[K\u001b[34;29H"]
