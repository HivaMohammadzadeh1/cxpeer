[0.0, "o", "\u001b[?25l\u001b[1;97H\u001b[K\u001b[2m\n\u2022\u001b[m\u000f \u001b[1mExplored\u001b[m\u000f\u001b[K\u001b[2m\u001b[3;97H  \u2514 \u001b[m\u000f\u001b[36mRead\u001b[39m SKILL.md (cxpeer skill)\u001b[K\u001b[4;97H    \u001b[36mList\u001b[39m rg --files -g '*.py' -g '*.js' -g '*.jsx' -g '*.ts' -g '*.tsx' -g\u001b[5;97H         '*.rs' -g '*.go' -g '*.java' -g '*.c' -g '*.h' -g '*.cc' -g\u001b[K\u001b[6;97H         '*.cpp'\u001b[K\u001b[7;97H         -g '*.hpp' -g '*.sh' -g '*.swift' -g '*.kt' -g '*.kts'\u001b[K\u001b[8;97H    \u001b[36mList\u001b[39m cxpeer\u001b[K\u001b[9;97H\u001b[K\u001b[2m\n\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[m\u000f\u001b[11;97H\u001b[K\u001b[2m\n\u2022 \u001b[m\u000fcxpeer/bridge.py \u2014 585 lines\u001b[K\u001b[13;97H  cxpeer/doctor.py \u2014 347 lines\u001b[K\u001b[14;97H  cxpeer/client.py \u2014 246 lines\u001b[K\u001b[15;97H\u001b[K\u001b[2m\n\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
